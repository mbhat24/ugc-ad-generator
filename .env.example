# ---- shared ----
APP_ENV=development              # production enables strict config validation and disables dev login
APP_URL=http://localhost:3000    # public URL of the web app (https in production)
API_PUBLIC_URL=                  # public base of the API for provider webhooks; default: APP_URL + /api
DATABASE_URL=postgres://adreel:adreel@localhost:5432/adreel
DATABASE_SSL=                    # off | require | verify (default: require in production)
DATABASE_CA=
PG_POOL_MAX=10

# ---- api / worker (backend) ----
ADDR=:8080
WORKER_ADDR=:9090
LOG_LEVEL=info
ALLOWED_ORIGINS=                 # comma-separated, only if the browser calls the API cross-origin
TRUSTED_PROXY_HOPS=1             # reverse proxies in front of the API (for client IP / rate limits)
METRICS_TOKEN=                   # optional bearer token for /metrics
ERROR_WEBHOOK_URL=               # optional Slack/Discord-compatible webhook for error alerts

# Supabase Auth: the API verifies access tokens (JWKS from SUPABASE_URL, or the legacy HS256 secret)
SUPABASE_URL=
SUPABASE_JWT_SECRET=
SUPABASE_SERVICE_ROLE_KEY=       # server only; needed for account deletion

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_GROWTH=
STRIPE_PRICE_SCALE=

# Object storage (S3-compatible). Private bucket + signed URLs unless S3_PRIVATE=0
S3_BUCKET=
S3_ENDPOINT=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=
S3_PRIVATE=
S3_PUBLIC_URL=

# Higgsfield (mock provider when unset)
HIGGSFIELD_KEY_ID=
HIGGSFIELD_KEY_SECRET=
HIGGSFIELD_MODEL=
HIGGSFIELD_WEBHOOK_SECRET=

# Optional: LLM-written copy and moderation
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Limits
MAX_PROJECTS_PER_HOUR=10
MAX_ADS_PER_DAY=30
WORKER_CONCURRENCY=5

# ---- web (Next.js) ----
API_URL=http://localhost:8080    # server-side URL of the API
NEXT_PUBLIC_SUPABASE_URL=        # also baked into the web image at build time
NEXT_PUBLIC_SUPABASE_ANON_KEY=
