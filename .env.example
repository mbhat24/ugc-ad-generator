APP_URL=http://localhost:3000

# Supabase (Auth + Postgres). DATABASE_URL = Supabase "Connection string" (use the pooler, session mode, for pg-boss)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
DATABASE_URL=

# Stripe subscriptions
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_GROWTH=
STRIPE_PRICE_SCALE=

# Video storage (S3-compatible: Cloudflare R2, AWS S3, MinIO). Without it, provider URLs are used and no captions are burned in.
S3_BUCKET=
S3_ENDPOINT=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PRIVATE=                     # unset = private bucket + signed URLs (recommended); 0 = public bucket, requires S3_PUBLIC_URL
S3_PUBLIC_URL=

# Optional: LLM-written hooks/scripts (falls back to templates)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Higgsfield (mock provider is used without these)
HIGGSFIELD_KEY_ID=
HIGGSFIELD_KEY_SECRET=
HIGGSFIELD_MODEL=

# Limits
MAX_PROJECTS_PER_HOUR=10
MAX_ADS_PER_DAY=30
WORKER_CONCURRENCY=5

# Optional: Higgsfield webhooks (needs public https APP_URL). Secret from Higgsfield Console > Settings (starts with whsec_). Polling remains the fallback.
HIGGSFIELD_WEBHOOK_SECRET=

# Production hardening
SUPABASE_SERVICE_ROLE_KEY=      # server only; needed for account deletion
DATABASE_SSL=                   # off | require | verify (default: require in production)
DATABASE_CA=
TRUSTED_PROXY_HOPS=1            # number of reverse proxies in front of the app (for client IP)
SIGNUPS_PER_IP_HOUR=5
PG_POOL_MAX=10
ERROR_WEBHOOK_URL=             # optional Slack/Discord-compatible webhook for error alerts
